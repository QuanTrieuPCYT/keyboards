    "keycodes": ["qmk_lighting"],
    "menus": 
    [
        {
            "label": "Lighting",
            "content":
            [
                {
                    "label": "logo rgb",
                    "content":
                    [
                        {
                            "label": "Logo State",
                            "type": "toggle",
                            "content": ["id_logo_toggle", 0, 6]
                        },
                        {
                            "showIf": "{id_logo_toggle} == 1 && {id_qmk_rgblight_effect} != 0",
                            "label": "Brightness",
                            "type": "range",
                            "options": [0, 105],
                            "content": ["id_qmk_rgblight_brightness", 2, 1]
                        },
                        {
                            "showIf": "{id_logo_toggle} == 1",
                            "label": "Effect",
                            "type": "dropdown",
                            "content": ["id_qmk_rgblight_effect", 2, 2],
                            "options":
                            [
                                [ "Off", 0 ],
                                [ "Wave", 1 ],
                                [ "Wave (1)", 2 ],
                                [ "Wave (2)", 3 ],
                                [ "Wave (fixed)", 4 ],
                                [ "Wave (RGB)", 5 ],
                                [ "Spectrum", 6 ],
                                [ "Breathe", 7 ],
                                [ "Breathe (RGB)", 8 ],
                                [ "Light", 9 ]
                            ]
                        },
                        {
                            "showIf": "{id_logo_toggle} == 1 && {id_qmk_rgblight_effect} != 0",
                            "label": "Effect Speed",
                            "type": "range",
                            "options": [0, 4],
                            "content": ["id_qmk_rgblight_effect_speed", 2, 3]
                        },
                        {
                            "showIf": "{id_logo_toggle} == 1 && {id_qmk_rgblight_effect} != 0 && {id_qmk_rgblight_effect} != 1 && {id_qmk_rgblight_effect} != 2 && {id_qmk_rgblight_effect} != 3 && {id_qmk_rgblight_effect} != 5 && {id_qmk_rgblight_effect} != 6 && {id_qmk_rgblight_effect} != 8",
